[Unit]
Description=Callcenter IA - servidor ASGI Daphne
After=network.target postgresql.service redis-server.service
Requires=postgresql.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/callcenter
Environment="DJANGO_SETTINGS_MODULE=callcenterdj.settings"
Environment="PYTHONUNBUFFERED=1"
Environment="KMP_DUPLICATE_LIB_OK=TRUE"
# Escucha solo en loopback: Nginx publica el puerto hacia afuera.
# Un solo proceso a propósito: Whisper y Piper quedan cargados en memoria y se
# comparten entre llamadas. Para escalar, levantar más puertos y balancear en Nginx.
ExecStart=/home/callcenter/venv/bin/daphne -b 127.0.0.1 -p 8501 --proxy-headers callcenterdj.asgi:application
Restart=always
RestartSec=5
StandardOutput=append:/var/log/callcenter/daphne.log
StandardError=append:/var/log/callcenter/daphne-error.log

[Install]
WantedBy=multi-user.target
